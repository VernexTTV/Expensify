<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="20dp"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Amount - Primary Focus -->
        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="₹ 0.00"
            android:textSize="20sp"
            android:textColor="@color/timeless_text_primary"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.01" />

        <!-- Actions - Minimal Icons -->
        <ImageButton
            android:id="@+id/btnEdit"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="@color/timeless_text_tertiary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit" />

        <ImageButton
            android:id="@+id/btnDelete"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/timeless_text_tertiary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Secondary Info - Subtle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Description"
            android:textSize="14sp"
            android:textColor="@color/timeless_text_secondary"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textSize="12sp"
            android:textColor="@color/timeless_text_tertiary"
            android:fontFamily="sans-serif"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <!-- Date & Payment - Tertiary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Date"
            android:textSize="12sp"
            android:textColor="@color/timeless_text_tertiary"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/tvPaymentMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment"
            android:textSize="12sp"
            android:textColor="@color/timeless_text_tertiary"
            android:fontFamily="sans-serif"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/tvDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/timeless_text_tertiary"
            android:fontFamily="sans-serif"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Subtle Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/timeless_divider"
        android:layout_marginTop="20dp" />

</LinearLayout>
