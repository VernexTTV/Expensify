<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Premium Dark Theme -->
    <style name="Theme.ExpenseTracker" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/luxury_purple_light</item>
        <item name="colorOnPrimary">@color/dark_background</item>
        <item name="colorPrimaryContainer">@color/luxury_purple_dark</item>
        <item name="colorOnPrimaryContainer">@color/luxury_purple_light</item>
        
        <item name="colorSecondary">@color/luxury_gold_light</item>
        <item name="colorOnSecondary">@color/dark_background</item>
        <item name="colorSecondaryContainer">@color/luxury_gold</item>
        
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/dark_surface</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Material Design 3 -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Material3.Corner.Medium</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.Corner.Large</item>
    </style>
    
    <!-- Premium Card Style Dark -->
    <style name="PremiumCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/dark_card</item>
    </style>
</resources>
