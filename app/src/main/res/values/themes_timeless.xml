<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <!-- Timeless Theme - Sophisticated & Minimal -->
    <style name="Theme.ExpenseTracker.Timeless" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/timeless_charcoal</item>
        <item name="colorOnPrimary">@color/timeless_white</item>
        <item name="colorSecondary">@color/timeless_gold</item>
        <item name="colorOnSecondary">@color/timeless_white</item>
        <item name="android:colorBackground">@color/timeless_white</item>
        <item name="colorSurface">@color/timeless_white</item>
        <item name="colorOnSurface">@color/timeless_text_primary</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/timeless_white</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/timeless_white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Typography Styles - Refined Hierarchy -->
    <style name="Timeless.Text.Headline1">
        <item name="android:textSize">42sp</item>
        <item name="android:textColor">@color/timeless_text_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Timeless.Text.Headline2">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/timeless_text_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Timeless.Text.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/timeless_text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Timeless.Text.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/timeless_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Timeless.Text.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/timeless_text_tertiary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Toolbar Title -->
    <style name="Timeless.Toolbar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/timeless_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

</resources>
