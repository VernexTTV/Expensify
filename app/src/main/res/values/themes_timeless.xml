<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <!-- Timeless Theme - Sophisticated & Minimal -->
    <style name="Theme.ExpenseTracker.Timeless" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/timeless_charcoal</item>
        <item name="colorOnPrimary">@color/timeless_white</item>
        <item name="colorSecondary">@color/timeless_gold</item>
        <item name="colorOnSecondary">@color/timeless_white</item>
        <item name="android:colorBackground">@color/timeless_white</item>
        <item name="colorSurface">@color/timeless_white</item>
        <item name="colorOnSurface">@color/timeless_text_primary</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/timeless_white</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/timeless_white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Text Styles -->
    <style name="Timeless.Text" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/timeless_text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Toolbar Styles -->
    <style name="Timeless.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/timeless_white</item>
    </style>

    <style name="Timeless.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/timeless_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

</resources>
